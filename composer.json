{
    "name": "sarueframework/orm",
    "description": "ORM for Sarue Framework",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "files": [
            "src/Query/Condition/functions.php"
        ],
        "psr-4": {
            "Sarue\\Orm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sarue\\Orm\\Tests\\Unit\\": "tests/unit",
            "Sarue\\Orm\\Tests\\Integration\\": "tests/integration",
            "Sarue\\Orm\\Tests\\Integration\\Dummy\\Generated\\": "tests/integration/var/sarue-generated"
        }
    },
    "authors": [
        {
            "name": "José San Martin",
            "email": "jose@josesanmartin.net"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "ext-pgsql": "*",
        "doctrine/dbal": "^4",
        "laminas/laminas-code": "^4.17",
        "ramsey/uuid": "^4.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2"
    },
    "scripts": {
        "test-psql": "echo; echo 'Connecting to test DB running on Docker. Password is: \"sarue\"'; psql -h localhost -U postgres sarue_integration_test_db",
        "test-cs": "vendor/bin/php-cs-fixer check --config=.php-cs-fixer.php",
        "test-cs-fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "test-phpstan": "vendor/bin/phpstan analyse src -l 9",
        "test-unit": "./tests/scripts/phpunit.sh unit just-test",
        "test-unit-coverage": "./tests/scripts/phpunit.sh unit coverage-report",
        "test-unit-coverage-100": "./tests/scripts/phpunit.sh unit coverage-100",
        "test-integration": "./tests/scripts/phpunit.sh integration just-test",
        "test-integration-coverage": "./tests/scripts/phpunit.sh integration coverage-report",
        "test-integration-coverage-100": "./tests/scripts/phpunit.sh integration coverage-100",
        "test": [
            "composer test-cs",
            "composer test-phpstan",
            "composer test-unit-coverage-100",
            "composer test-integration-coverage-100"
        ]
    }
}
